# ~/.bashrc example — copy to ~/.bashrc và điền phần của riêng bạn.
# File thật bị git-ignore (whitelist repo). Hiện KHÔNG cần key nào ở đây:
# key agnes/gemini của agentmemory nằm ở ~/.agentmemory/.env.

# ... (your distro's default bashrc content: prompt, aliases, colors) ...

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"  # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# KHÔNG export OPENAI_API_KEY ở đây.
# Stack Bifrost/Codex đã được gỡ (10/2026). Nếu shell export một key, nó sẽ ĐÈ
# OPENAI_API_KEY trong ~/.agentmemory/.env (process.env thắng file .env),
# khiến agentmemory gọi nhầm endpoint. Key agnes/gemini của agentmemory nằm ở
# ~/.agentmemory/.env — xem dotfiles/agentmemory-env.example.

# bifrost — (đã ngừng dùng 10/2026: Codex CLI + Bifrost stack được tháo gỡ,
#   tools/bifrost-stack.sh và tools/codex-ns-shim/ đã xoá khỏi repo.)
