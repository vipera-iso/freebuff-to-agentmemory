# ============================================================
# Whitelist .gitignore for the $HOME dotfiles repo.
# Everything is ignored by default; only the paths un-ignored
# below are tracked.
#
# Secret-bearing files are IGNORED on purpose (never commit):
#   - ~/.bashrc                       (Bifrost Virtual Key)
#   - ~/.config/bifrost/config.json   (Bifrost setup token)
#   - hethong.md                      (ops report, contains setup token)
# Tracked instead: redacted *.example templates in dotfiles/.
# ============================================================

/*

# --- repo files ---
!/.gitignore
!/README.md

# --- tools (real paths, no secrets) ---
!/tools/
/tools/*
!/tools/bifrost-stack.sh
!/tools/codex-ns-shim/
/tools/codex-ns-shim/__pycache__/

# --- codex config (reviewed: no credentials inside) ---
!/.codex/
.codex/*
!/.codex/config.toml
!/.codex/hooks.json

# --- systemd user units (auto-start stack at boot via linger) ---
!/.config/
.config/*
!/.config/systemd/
.config/systemd/*
!/.config/systemd/user/
.config/systemd/user/*
!/.config/systemd/user/bifrost.service
!/.config/systemd/user/codex-ns-shim.service

# --- redacted templates for the secret-bearing files ---
!/dotfiles/
/dotfiles/*
!/dotfiles/bashrc.example
!/dotfiles/bifrost-config.example.json

# --- ops report (setup token redacted; real one stays at $HOME/hethong.md) ---
!/docs/
/docs/*
!/docs/hethong.md

# --- data pipeline skeleton (docs + modules + scripts; data/repos/logs/venv stay ignored
#     via data_pipeline/.gitignore — raw content, cloned repos, run output, venv) ---
!/data_pipeline/
