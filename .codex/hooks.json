{
  "hooks": {
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/home/user/.codex/squeez/hooks/codex-session-start.sh\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/home/user/.codex/squeez/hooks/codex-pretooluse.sh\"",
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"/home/user/.codex/squeez/hooks/codex-posttooluse.sh\"",
            "timeout": 3000
          }
        ]
      }
    ]
  }
}