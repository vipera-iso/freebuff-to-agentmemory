[Unit]
Description=Bifrost gateway (:8080) — Codex CLI -> Agnes AI
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/home/user/.nvm/versions/node/v24.21.0/bin/bifrost
Restart=always
RestartSec=3
StandardOutput=append:/tmp/bifrost.log
StandardError=append:/tmp/bifrost.log

[Install]
WantedBy=default.target
